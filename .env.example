# Copie para .env (ou ~/.config/portfolio/.env) e preencha. Nunca faça commit do .env.
GEMINI_API_KEY=
# Opcional
GEMINI_MODEL=gemini-3.8-flash
# Preço por 1M tokens em USD, para estimar custo no benchmark (0 = tier gratuito)
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
# Envio de e-mail: "eml" (padrão, só grava o arquivo) ou "smtp" (envio real, sempre após aprovação humana)
OPSAGENT_EMAIL_BACKEND=eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
